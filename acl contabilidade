    <script>
        // Sistema do Quiz
        let currentStep = 1;
        const totalSteps = 4;
        let quizData = { answers: {}, contact: {} };
        
        // Inicializar opções
        document.querySelectorAll('.quiz-option').forEach(option => {
            option.addEventListener('click', function() {
                const stepOptions = this.closest('.quiz-step').querySelectorAll('.quiz-option');
                stepOptions.forEach(opt => opt.classList.remove('selected'));
                this.classList.add('selected');
                const question = this.closest('.quiz-step').querySelector('.quiz-question').textContent;
                const answer = this.querySelector('span').textContent;
                const step = this.closest('.quiz-step').id.replace('step-', '');
                quizData.answers[`step${step}`] = { question, answer, value: this.getAttribute('data-value') };
            });
        });
        
        function nextStep(step) {
            if (step !== 'contact') {
                const currentStepElement = document.getElementById(`step-${currentStep}`);
                const selectedOption = currentStepElement.querySelector('.quiz-option.selected');
                if (!selectedOption) { alert('Por favor, selecione uma opção antes de continuar.'); return; }
            }
            document.getElementById(`step-${currentStep}`).classList.remove('active');
            if (step === 'contact') {
                document.getElementById('step-contact').classList.add('active');
            } else {
                document.getElementById(`step-${step}`).classList.add('active');
            }
            if (step === 'contact') {
                currentStep = 'contact';
                document.getElementById('quiz-progress-bar').style.width = '100%';
            } else {
                currentStep = step;
                const progress = ((step - 1) / totalSteps) * 100;
                document.getElementById('quiz-progress-bar').style.width = `${progress}%`;
            }
        }
        
        function prevStep(step) {
            if (currentStep === 'contact') {
                document.getElementById('step-contact').classList.remove('active');
            } else {
                document.getElementById(`step-${currentStep}`).classList.remove('active');
            }
            document.getElementById(`step-${step}`).classList.add('active');
            currentStep = step;
            if (step === 'contact') {
                document.getElementById('quiz-progress-bar').style.width = '100%';
            } else {
                const progress = ((step - 1) / totalSteps) * 100;
                document.getElementById('quiz-progress-bar').style.width = `${progress}%`;
            }
        }
        
        function submitQuiz() {
            const name = document.getElementById('client-name').value.trim();
            const email = document.getElementById('client-email').value.trim();
            const phone = document.getElementById('client-phone').value.trim();
            if (!name || !email || !phone) { alert('Por favor, preencha todos os campos do formulário.'); return; }
            quizData.contact = { name, email, phone };
            sendQuizData();
            document.getElementById('step-contact').classList.remove('active');
            document.getElementById('quiz-result').classList.add('active');
        }
        
        async function sendQuizData() {
            try {
                const formData = {
                    nome: quizData.contact.name,
                    email: quizData.contact.email,
                    telefone: quizData.contact.phone,
                    data_hora: new Date().toLocaleString('pt-BR'),
                    respostas: quizData.answers,
                    origem: 'Site ACL Contabilidade - Quiz Interativo'
                };
                let emailBody = `📊 NOVO LEAD DO QUIZ - ACL CONTABILIDADE\n\n👤 DADOS DO CLIENTE:\nNome: ${formData.nome}\nEmail: ${formData.email}\nTelefone: ${formData.telefone}\nData/Hora: ${formData.data_hora}\nOrigem: ${formData.origem}\n\n📝 RESPOSTAS DO QUIZ:\n`;
                for (const step in formData.respostas) {
                    const answer = formData.respostas[step];
                    emailBody += `\n${step.toUpperCase()}:\nPergunta: ${answer.question}\nResposta: ${answer.answer}\nValor: ${answer.value}\n`;
                }
                // ENVIO PARA EMAIL - Configure o Formspree depois
                const response = await fetch('https://formspree.io/f/mpzvqvwg', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        _subject: `🎯 Novo Lead Quiz: ${formData.nome}`,
                        _replyto: formData.email,
                        nome: formData.nome,
                        email: formData.email,
                        telefone: formData.telefone,
                        mensagem: emailBody,
                        tipo: 'quiz_contabilidade'
                    })
                });
                console.log('Dados enviados!');
            } catch (error) { console.error('Erro:', error); }
        }
        
        // Animações
        document.addEventListener('DOMContentLoaded', function() {
            const fadeElements = document.querySelectorAll('.fade-in');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => { if (entry.isIntersecting) entry.target.style.animation = 'fadeIn 0.8s ease-out'; });
            }, { threshold: 0.1 });
            fadeElements.forEach(element => observer.observe(element));
            // Efeito de digitação
            const heroTitle = document.querySelector('.hero h2');
            const originalText = heroTitle.textContent;
            heroTitle.textContent = '';
            let i = 0;
            function typeWriter() { if (i < originalText.length) { heroTitle.textContent += originalText.charAt(i); i++; setTimeout(typeWriter, 50); } }
            setTimeout(typeWriter, 500);
        });
    </script>
